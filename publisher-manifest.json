t: bold;color: var(--wine-deep);margin-bottom: 6px;font-size: 0.98rem}\n\n  .faq-item .a {font-size: 0.92rem;color: var(--ink);line-height: 1.7}\n\n  /* Clients section */\n  .clients-note {border-left: 4px solid var(--wine);padding: 20px 24px;background: rgba(245, 236, 217, 0.5)}\n\n  .clients-note p {margin-bottom: 12px}\n\n  .clients-note p:last-child {margin-bottom: 0}\n\n  /* Footer nav — 底部固定式文字导航 */\n  .footer-nav {position: fixed;bottom: 0;left: 0;width: 100%;background: var(--wine-deep);color: var(--ivory);padding: 14px 8vw;display: flex;justify-content: space-between;align-items: center;flex-wrap: wrap;gap: 10px;font-size: 0.85rem;letter-spacing: 0.05em;z-index: 100}\n\n  .footer-nav .brand-mark {font-style: italic;opacity: 0.8}\n\n  .footer-nav a {color: var(--ivory);text-decoration: none;margin-left: 16px;opacity: 0.85}\n\n  .footer-nav a:hover {opacity: 1;text-decoration: underline}\n\n  @media (max-width: 640px) {\n    .band {padding: 40px 6vw}\n    .band-1 {padding-top: 60px}\n    section {padding: 50px 6vw}\n    .plan:nth-child(1),\n    .plan:nth-child(2),\n    .plan:nth-child(3) {margin-left: 0;width: 100%}\n    .footer-nav {flex-direction: column;gap: 6px;padding: 10px 6vw}\n    .footer-nav a {margin-left: 0;margin: 0 8px}\n  }\n</style><main>\n\n  \n  <header class=\"hero\">\n    <div class=\"band band-1\">\n      <h1>fly云(flycloud)</h1>\n      <p class=\"subtitle\">一条穿越网络云层的安静通道，为日常浏览、流媒体观看与团队协作提供分层递进的流量方案。</p>\n    </div>\n    <div class=\"band band-2\">\n      <div class=\"meta-line\">\n        <span>分层套餐</span>\n        <span>多设备支持</span>\n        <span>专线优化</span>\n      </div>\n    </div>\n    <div class=\"band band-3\">\n      <p class=\"lead\">\n        我第一次接触 fly云，是在一个需要反复切换节点才能打开页面的深夜。它没有铺天盖地的宣传，只是安静地把自己分成<em>基础、旗舰、团队</em>三层，让你根据实际用量找到自己的位置。这篇文章，算是对它一段时间使用后的记录。\n      </p>\n    </div>\n  </header>\n\n  \n  <section id=\"about\">\n    <h2>关于 fly云</h2>\n    <p class=\"section-intro\">以下内容基于实际使用观察，不涉及任何未经确认的官方信息。</p>\n\n    <div class=\"card\">\n      <p>fly云(flycloud)提供按月计费的流量套餐，覆盖从个人日常到团队协作的不同使用场景。套餐之间的区别主要体现在流量配额、同时在线设备数以及节点资源层级上。</p>\n    </div>\n\n    <div class=\"card\">\n      <p>它不做\"无限流量\"的承诺，也不声称覆盖某个具体数字的全球节点。每一档套餐都明确标注了流量上限和设备数量，这种克制反而让人对账单更有预期。</p>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\" class=\"plans\">\n    <h2>套餐方案</h2>\n    <p class=\"section-intro\">三档套餐按用量递进排列，旗舰版居中并作推荐标记。年付价格在对应月付基础上折算。</p>\n\n    <div class=\"plan-ladder\">\n\n      <article class=\"plan\">\n        <span class=\"tag\">入门</span>\n        <h3>基础版</h3>\n        <div class=\"price\">¥15/月</div>\n        <div class=\"annual\">按年付仅需 ¥150/年</div>\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <span class=\"recommended-mark\">推荐</span>\n        <span class=\"tag\">进阶</span>\n        <h3>旗舰版</h3>\n        <div class=\"price\">¥35/月</div>\n        <div class=\"annual\">按年付仅需 ¥350/年</div>\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <span class=\"tag\">团队</span>\n        <h3>团队版</h3>\n        <div class=\"price\">¥85/月</div>\n        <div class=\"annual\">按年付仅需 ¥850/年</div>\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n\n    </div>\n  </section>\n\n  \n  <section id=\"usage\">\n    <h2>使用说明</h2>\n    <p class=\"section-intro\">以下步骤基于一般使用流程整理，具体界面以实际版本为准。</p>\n\n    <div class=\"usage-step\">\n      <div class=\"num\">第一步</div>\n      <h3>选择套餐并完成订阅</h3>\n      <p>根据每月大致用量选择对应档位。如果主要用于日常浏览和偶尔观看流媒体，基础版的 100GB 通常够用；如果有多设备需求或对线路质量有更高要求，旗舰版会更合适。</p>\n    </div>\n\n    <div class=\"usage-step\">\n      <div class=\"num\">第二步</div>\n      <h3>获取连接配置</h3>\n      <p>订阅完成后，在账户页面获取对应协议的连接配置。fly云支持常见的客户端协议导入，可通过扫码或订阅链接方式同步到设备。</p>\n    </div>\n\n    <div class=\"usage-step\">\n      <div class=\"num\">第三步</div>\n      <h3>在设备上启用连接</h3>\n      <p>导入配置后，在客户端中选择对应节点并启用连接。建议首次使用时在不同时段测试几次，以了解线路在高峰期的实际表现。</p>\n    </div>\n\n    <div class=\"usage-step\">\n      <div class=\"num\">第四步</div>\n      <h3>监控流量用量</h3>\n      <p>套餐流量按月重置。在账户面板可以查看当前周期已用流量和剩余配额，避免在月末突然耗尽。团队版用户可通过专属客户经理获取用量报表。</p>\n    </div>\n  </section>\n\n  \n  <section id=\"clients\">\n    <h2>客户端支持</h2>\n    <p class=\"section-intro\">关于官方客户端的下载地址和具体平台支持范围，目前没有可确认的公开信息。</p>\n\n    <div class=\"clients-note\">\n      <p>fly云的连接配置基于通用协议，这意味着大多数主流第三方客户端都可以导入使用，包括桌面端和移动端的常见工具。</p>\n      <p>关于是否有官方独立客户端、具体支持哪些操作系统平台，以及对应的下载地址，建议通过订阅后的账户面板或工单系统获取最新信息。本页面不提供任何未经确认的下载链接。</p>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\">\n    <h2>常见问题</h2>\n    <p class=\"section-intro\">按使用阶段分为三组：套餐选择、连接使用、账户管理。</p>\n\n    <div class=\"faq-group\">\n      <h3>套餐与价格</h3>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">基础版和旗舰版的主要区别是什么？</div>\n        <div class=\"a\">最核心的区别在于流量配额和节点资源。基础版每月 100GB，使用普通线路节点池；旗舰版每月 300GB，访问全节点并包含 IPLC 专线优化，同时支持流媒体原生解锁。设备数也从 3 台提升到 5 台。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">年付价格是怎么折算的？</div>\n        <div class=\"a\">基础版年付 ¥150，相当于按月付 ¥15 计算 10 个月的价格，即两个月免费。旗舰版和团队版同理，年付分别为 ¥350 和 ¥850，均为月付价格的 10 倍。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">团队版适合几个人使用？</div>\n        <div class=\"a\">团队版支持 20 台设备同时在线，月流量 1000GB。如果团队每人 2-3 台设备，大约可以覆盖 7-10 人。具体取决于每个人的实际用量习惯。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>连接与使用</h3>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">流量用完了会怎样？</div>\n        <div class=\"a\">当月流量用尽后，连接会暂停直到下一个计费周期重置。不会产生超额扣费。如果经常在月末用完，建议升级到更高档位或单独购买流量包（如有提供）。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">可以同时在多台设备上使用吗？</div>\n        <div class=\"a\">可以，但受套餐限制。基础版 3 台、旗舰版 5 台、团队版 20 台。超出限制后，新设备无法同时连接，需要先在旧设备上断开。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">流媒体解锁具体指什么？</div>\n        <div class=\"a\">基础版支持基础流媒体解锁，旗舰版标注为\"全节点原生流媒体解锁\"。这意味着旗舰版用户通过对应节点访问流媒体平台时，可以获得该地区原生 IP 的访问权限，而非通过中转方式。具体平台兼容性以实际使用为准。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>账户与支持</h3>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">可以随时更换套餐吗？</div>\n        <div class=\"a\">通常可以在订阅周期到期后切换套餐档位。升级到更高档位时，部分情况可能支持即时生效并补差价。具体规则建议在账户面板查看或通过工单确认。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">不同套餐的工单支持有什么区别？</div>\n        <div class=\"a\">基础版和团队版均为常规工单响应。旗舰版标注\"7x24 优先工单支持\"，意味着工单会被优先处理。团队版则配备专属客户经理，可以直接对接沟通。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">支持哪些支付方式？</div>\n        <div class=\"a\">关于具体支持的支付方式，本页面没有可确认的信息。建议在订阅页面查看实际可用的支付选项，通常包括常见的人民币支付渠道。</div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n\n<nav class=\"footer-nav\">\n  <span class=\"brand-mark\">fly云(flycloud)</span>\n  <div>\n    <a href=\"#about\">关于</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#usage\">使用</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">FAQ</a>\n  </div>\n</nav>",
